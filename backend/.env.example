# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newtonite_ops

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=change-me-in-production-use-a-strong-random-secret
JWT_EXPIRES_IN=24h

# Lock
LOCK_TIMEOUT_MINUTES=30

# Demo
# Fill the in-memory stores with demo users/teams/items at startup (local use only)
SEED_DEMO_DATA=false
# Directory of the web app to serve (defaults to ../frontend)
# FRONTEND_DIR=
