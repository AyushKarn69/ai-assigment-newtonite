# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database
# Leave DATABASE_URL unset to run on in-memory storage. Apply the schema with: npm run db:migrate
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/newtonite_ops
# Separate database for tests (it is emptied by the test suite!): npm run test:db
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/newtonite_ops_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=change-me-in-production-use-a-strong-random-secret
JWT_EXPIRES_IN=24h

# Lock
LOCK_TIMEOUT_MINUTES=30

# Demo
# Fill the in-memory stores with demo users/teams/items at startup (local use only)
SEED_DEMO_DATA=false
# Directory of the web app to serve (defaults to ../frontend)
# FRONTEND_DIR=

# Self-service sign-up (accounts are plain users with no team until a manager adds them)
ALLOW_REGISTRATION=true
